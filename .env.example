# Silvercurrent — environment variables
# Copy to .env (or .env.local) and fill in real values. .env files are gitignored.

# Anthropic API key — used by all four runtime agents.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQLAlchemy DB connection string.
# Default (no Docker, charter-endorsed for dev): file-backed SQLite via aiosqlite.
# Migrate to Postgres later when JSONB / full-text / concurrent writers actually matter.
# Format examples:
#   SQLite (default):  sqlite+aiosqlite:///./silvercurrent.db
#   Postgres (later):  postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./silvercurrent.db

# Chroma vector DB — directory for the persistent file-backed client.
# No server. The directory is created on first use; gitignored under data/.
CHROMA_PERSIST_DIR=./.chroma

# Inbound email address that receives forwarded broker alerts.
# Phase 4 (email ingestion) wires this to a parsing daemon. Placeholder until then.
INGESTION_EMAIL_ADDRESS=ingest@silvercurrent.local

# Frontend → backend URL. Used by lib/api.ts in the Next.js app.
NEXT_PUBLIC_API_URL=http://localhost:8000
