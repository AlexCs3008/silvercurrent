# Silvercurrent — environment variables
# Copy to .env (or .env.local) and fill in real values. .env files are gitignored.

# Anthropic API key — used by all four runtime agents.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres connection string. The docker-compose default points at the local container.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://silvercurrent:silvercurrent@localhost:5432/silvercurrent

# Chroma vector DB — host:port of the running Chroma instance.
# In docker-compose this resolves to the chroma service.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Inbound email address that receives forwarded broker alerts.
# Phase 4 (email ingestion) wires this to a parsing daemon. Placeholder until then.
INGESTION_EMAIL_ADDRESS=ingest@silvercurrent.local

# Frontend → backend URL. Used by lib/api.ts in the Next.js app.
NEXT_PUBLIC_API_URL=http://localhost:8000
